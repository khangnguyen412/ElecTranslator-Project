{
  "name": "electranslator",
  "private": true,
  "version": "0.1.4",
  "description": "Capture on-screen manga/comic text and translate to Vietnamese with local LLM or cloud AI.",
  "main": "dist-electron/main.js",
  "packageManager": "pnpm@10.15.0",
  "author": {
    "name": "Khang Nguyen",
    "email": "ronglun412@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/khangnguyen412/ElecTranslator-Project.git"
  },
  "license": "MIT",
  "scripts": {
    "build:electron": "tsc -p electron/tsconfig.json",
    "build:overlay": "vite build --outDir dist/overlay --base ./",
    "build:frontend": "vite build",
    "build": "pnpm build:electron && pnpm build:frontend && pnpm build:overlay",
    "dist": "pnpm build && electron-builder",
    "clean": "rimraf release dist",
    "dev": "concurrently --kill-others \"vite\" \"npm run electron:dev\"",
    "electron:dev": "wait-on http://localhost:5173 && tsc -p electron/tsconfig.json && cross-env NODE_ENV=development electron . ",
    "preview": "vite preview",
    "verify:bundle": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/verify-bundle.ps1",
    "verify:release": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/verify-bundle.ps1 -Strict"
  },
  "build": {
    "appId": "com.electranslator.app",
    "productName": "ElecTranslator",
    "asar": true,
    "publish": [
      {
        "provider": "github",
        "owner": "khangnguyen412",
        "repo": "ElecTranslator-Project",
        "releaseType": "draft"
      }
    ],
    "files": [
      "dist/**/*",
      "dist-electron/**/*.js",
      "!dist-electron/**/*.map",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "assets",
        "to": "assets"
      },
      {
        "from": "electron/module/screenshot",
        "to": "screenshot",
        "filter": [
          "*.html"
        ]
      },
      {
        "from": "resources/scripts",
        "to": "scripts"
      },
      {
        "from": "../backend",
        "to": "backend",
        "filter": [
          "**/*",
          "!**/__pycache__/**",
          "!**/*.pyc",
          "!**/*.pyo",
          "!.env",
          "!.env.*",
          "!.pytest_cache/**",
          "!tests/**",
          "!**/*.log"
        ]
      }
    ],
    "win": {
      "icon": "assets/logo.png",
      "target": "nsis"
    },
    "mac": {
      "icon": "assets/logo.png",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "linux": {
      "icon": "assets/logo.png",
      "target": [
        "AppImage"
      ],
      "category": "Utility"
    },
    "directories": {
      "output": "release"
    }
  },
  "dependencies": {
    "@ant-design/icons": "^6.2.3",
    "@reduxjs/toolkit": "^2.12.0",
    "@tomjs/electron-devtools-installer": "^4.0.1",
    "antd": "^6.4.0",
    "axios": "^1.16.1",
    "canvas": "^3.2.3",
    "change-case": "^5.4.4",
    "electron-store": "^11.0.2",
    "electron-updater": "^6.3.9",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-redux": "^9.3.0",
    "react-router-dom": "^6.30.3",
    "screenshot-desktop": "^1.15.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.12.3",
    "@types/node-notifier": "^8.0.5",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^42.1.0",
    "electron-builder": "^26.8.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "rimraf": "^6.1.3",
    "sass-embedded": "^1.100.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12",
    "wait-on": "^9.0.10"
  }
}