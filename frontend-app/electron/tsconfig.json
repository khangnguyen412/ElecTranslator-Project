{
    "compilerOptions": {
        "target": "ES2020",
        "module": "CommonJS",
        "lib": [
            "ES2020",
            "ES2022.Error"
        ],
        "outDir": "../dist-electron",
        "rootDir": ".",
        "strict": true,
        "skipLibCheck": true,
        "esModuleInterop": true,
        "resolveJsonModule": true
    },
    "include": [
        "./**/*",
        "module/ocr/ocr-worker-thread.ts"
    ],
    "exclude": [
        "**/*.test.ts"
    ]
}